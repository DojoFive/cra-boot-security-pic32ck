--- a/soc/microchip/pic32c/pic32ck_sg_gc/Kconfig.defconfig
+++ b/soc/microchip/pic32c/pic32ck_sg_gc/Kconfig.defconfig
@@ -9,14 +9,21 @@ config NUM_IRQS
 config SYS_CLOCK_HW_CYCLES_PER_SEC
 	default $(dt_node_int_prop_int,/cpus/cpu@0,clock-frequency)
 
+# Under MCUboot each application image keeps its vector table in PFM after
+# the image header. 0x400 satisfies VTOR alignment for NUM_IRQS=158:
+# next_power_of_2((16 + 158) * 4) = 1024.
+config ROM_START_OFFSET
+	default 0x400 if BOOTLOADER_MCUBOOT && !MCUBOOT
+
 config ROMSTART_RELOCATION_ROM
+	default n if BOOTLOADER_MCUBOOT || MCUBOOT
 	default y
 
 config ROMSTART_REGION_ADDRESS
 	default $(dt_nodelabel_reg_addr_hex,flash0)
 
 config ROMSTART_REGION_SIZE
-	default $(dt_nodelabel_reg_size_hex,flash0,0,k)
+	default $(dt_nodelabel_reg_size_hex,boot_partition,0,k)
 
 config ARM_TRUSTZONE_M
 	default y
